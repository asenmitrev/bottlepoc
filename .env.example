# Only needed if data/download.py has to fall back to a fresh Roboflow API
# pull. For this run it is NOT required: the source dataset already exists
# on disk (see README.md "Dataset provenance") and download.py uses it
# directly.
ROBOFLOW_API_KEY=your_api_key_here

# Optional: override where download.py looks for the source COCO-format
# dataset. Defaults to "../Bottle Defects.v28i.coco" relative to this repo.
BOTTLE_DATASET_SOURCE_DIR=
